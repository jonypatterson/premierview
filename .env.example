# PremierView — Supabase. Copy to .env.local and fill in.
# Both reads run server-side, so these stay out of the client bundle.
# Find them in the Supabase dashboard: Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=

# Google Analytics 4. Optional — leave it unset and no tag is rendered, which
# is what keeps local runs and preview deployments out of the numbers. The
# measurement ID identifies the property rather than granting access to it, so
# unlike the keys above it is public and has to be, since gtag runs in the
# browser. Analytics → Admin → Data streams → your stream.
NEXT_PUBLIC_GA_ID=
